[Unit]
Description=Notes Library - Shobhit University Gangoh Portal
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/23014168025/noteslib
Environment="PATH=/var/www/23014168025/noteslib/venv/bin:/usr/local/bin:/usr/bin"
Environment="DB_PATH=/var/www/23014168025/noteslib/notes_library.db"
ExecStart=/var/www/23014168025/noteslib/venv/bin/gunicorn --workers 4 --bind 0.0.0.0:3000 --timeout 120 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
